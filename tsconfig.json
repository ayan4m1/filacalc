{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "target": "es6",
    "rootDir": ".",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["w3c-web-serial"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.d.ts"]
}
